# Written by claude-skills:setup. Installs gitleaks 8.30.1, the release the
# CI workflow pins, into the DDEV web image, so the secret scan of
# `composer test` runs the same locally as in CI. `ddev restart` builds it.
# The checksums are gitleaks' own (gitleaks_8.30.1_checksums.txt).
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) arch=x64; sum=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;; \
        arm64) arch=arm64; sum=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;; \
        *) echo "gitleaks: no pinned archive for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    archive="gitleaks_8.30.1_linux_${arch}.tar.gz"; \
    cd /tmp; \
    curl -sSfL --retry 3 --proto '=https' --tlsv1.2 -o "${archive}" "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/${archive}"; \
    echo "${sum}  ${archive}" | sha256sum -c -; \
    tar -xzf "${archive}" --no-same-owner -C /usr/local/bin gitleaks; \
    rm -f "${archive}"
